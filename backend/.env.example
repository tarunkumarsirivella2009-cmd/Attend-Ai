# AttendAI Backend Environment Configuration

# Server Port (Render sets this dynamically via the PORT environment variable)
PORT=8000

# CORS: Set to your deployed Vercel URL (e.g. https://attend-ai.vercel.app)
# You can provide multiple comma-separated URLs
FRONTEND_URL=https://attend-ai.vercel.app

# Database Connection:
# Default: sqlite:///./attendai.db
# For production persistence on Render free tier, connect a free Supabase PostgreSQL database:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./attendai.db

# JWT Signing Secret (Generate a strong random string in production)
ATTENDAI_SECRET_KEY=attendai_secret_key_gvpce_change_in_production_2026
